# ──────────────────────────────────────────────────────────
# F1 Telemetry Backend — Environment Configuration
# Copy this file to .env and fill in values.
# DO NOT commit .env to version control.
# ──────────────────────────────────────────────────────────

# ── Cassandra ────────────────────────────────────────────
# Comma-separated host list (e.g. "127.0.0.1" or "10.0.0.1,10.0.0.2")
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
KEYSPACE=f1_telemetry
ASTRA_TOKEN=AstraCS:PBqFlJBIxpjcyRrSataUoJew:4241e88038fd1181113441ffd79f211baae6ad10ff954d25208dd3658c22cc98
SECURE_CONNECT_BUNDLE=./secure-connect-f1_telemetry_system.zip
ASTRA_KEYSPACE=f1_telemetry_system

# ── API ──────────────────────────────────────────────────
API_PORT=8000
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500

# ── Cassandra JVM heap (tune for available RAM) ──────────
# 1G/256M works on 8 GB laptops.
# Increase to 2G/512M if you have 16 GB RAM.
MAX_HEAP_SIZE=1G
HEAP_NEWSIZE=256M

# ── Logging ──────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── ML ───────────────────────────────────────────────────
MODEL_VERSION=xgb-1.0
